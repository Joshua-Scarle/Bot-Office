[Unit]
Description=Crewdeck controller (PrintPilot)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/printpilot-agentdesk
Environment=AGENTDESK_TOKEN_FILE=%h/printpilot-agentdesk/data/token
Environment=AGENTDESK_DATA_DIR=%h/printpilot-agentdesk/data
Environment=PATH=%h/printpilot-agentdesk/bin:%h/.local/bin:%h/.grok/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/printpilot-agentdesk/.venv/bin/python -m agentdesk
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
