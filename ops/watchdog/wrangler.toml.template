# Copy to wrangler.toml and fill in the placeholders. Do not commit the filled-in file.
name = "bot-office-watchdog"
main = "src/index.js"
compatibility_date = "2026-11-01"

[triggers]
crons = ["*/5 * * * *"]

[[durable_objects.bindings]]
name = "WATCHDOG"
class_name = "Watchdog"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Watchdog"]

[[send_email]]
name = "ALERT_EMAIL"
destination_address = "<ALERT_RECIPIENT>"   # the sole recipient: Cloudflare refuses any other; must equal ALLOWED_RECIPIENT

[vars]
ALLOWED_RECIPIENT = "<ALERT_RECIPIENT>"   # the one address the Worker may mail; missing or not one plain address = refuses to run (503)
ALERT_TO = "<ALERT_RECIPIENT>"   # must equal ALLOWED_RECIPIENT; the Worker refuses to run (503) otherwise
ALERT_FROM = "watchdog@<YOUR_DOMAIN_WITH_EMAIL_ROUTING>"
# HEARTBEAT_SECRET is a Worker secret: wrangler secret put HEARTBEAT_SECRET
