# Copy to wrangler.toml and fill in the placeholders. Do not commit the filled-in file.
name = "bot-office-watchdog"
main = "src/index.js"
compatibility_date = "2026-11-01"

[triggers]
crons = ["*/5 * * * *"]

[[durable_objects.bindings]]
name = "WATCHDOG"
class_name = "Watchdog"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Watchdog"]

[[send_email]]
name = "ALERT_EMAIL"
destination_address = "you@example.test"   # the sole recipient: Cloudflare refuses any other, and the Worker checks it at start

[vars]
ALERT_TO = "you@example.test"   # must be exactly this; the Worker refuses to run (503) otherwise
ALERT_FROM = "watchdog@<YOUR_DOMAIN_WITH_EMAIL_ROUTING>"
# HEARTBEAT_SECRET is a Worker secret: wrangler secret put HEARTBEAT_SECRET
