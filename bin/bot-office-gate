#!/usr/bin/env python3
"""Bot-Office action gate: a CLI hook that asks the controller before a tool runs.

Usage (set by Bot-Office per invocation, never globally):
    bot-office-gate <claude|codex|cursor|antigravity|opencode> [--mode attended|unattended|local]

Reads the hook JSON on stdin, POSTs it to $BOT_OFFICE_API_URL/v1/agent/gate with the job's
$BOT_OFFICE_AGENT_TOKEN and answers in the CLI's own hook format. The controller decides. It fails
closed (0.12.4 fix2): an event it cannot read (garbage, truncated, an unknown shape), a controller
it cannot reach or whose answer it cannot read, a crash of this script and running out of time
(DEADLINE, under the 30 s hook timeout the adapters set) all deny.
- local (a job with no bot: no token, no chat for a card): protected paths, the git guard and
  sending to people are refused here; anything else is allowed;
- unattended or attended with no token: deny;
- no token and no mode (Joshua's own CLI): no-op.
Stdlib only. Never prints the token.
"""
import json
import os
import re
import signal
import sys
import urllib.error
import urllib.parse
import urllib.request

PROVIDERS = ("claude", "codex", "cursor", "antigravity", "opencode")
# kept in sync with botoffice.rules.SECRET_MARKERS (a test checks)
SECRET_MARKERS = ("agentdesk.sqlite3", "grok_webhook.json", "/data/token", "bot-office/private",
                  ".config/bot-office/token", "gate-capabilities.json")
# kept in sync with botoffice.rules.CONTENT_KEYS: file content and search text are not locations
CONTENT_KEYS = frozenset({"content", "contents", "new_string", "old_string", "new_source", "text", "pattern",
                          "prompt", "description", "query", "message", "body", "edits", "todos"})
LOOPBACK_HOSTS = ("127.0.0.1", "localhost")
STDIN_LIMIT = 1024 * 1024
MODES = ("attended", "unattended", "local")


def _seconds(name, default, low, high):
    try:
        return max(low, min(high, float(os.environ.get(name) or default)))
    except ValueError:
        return default


# the hook timeout in the adapters is 30 s: answer (deny) well before the CLI gives up on the hook
TIMEOUT = _seconds("BOT_OFFICE_GATE_TIMEOUT", 20, 0.5, 20)
DEADLINE = TIMEOUT + 4


def _answer(provider, allow, reason=""):
    """Print the CLI's hook answer; return the exit code."""
    if provider == "cursor":
        if allow:
            print(json.dumps({"permission": "allow"}))
            return 0
        print(json.dumps({"permission": "deny", "user_message": reason, "agent_message": reason,
                          "userMessage": reason, "agentMessage": reason}))
        return 2
    if allow:
        return 0
    if provider == "antigravity":
        print(json.dumps({"decision": "deny", "reason": reason}))
    elif provider in ("claude", "codex"):
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": reason}}))
    # exit 2 blocks the tool call and feeds stderr back to the model (Claude, Codex, agy hooks)
    sys.stderr.write(reason + "\n")
    return 2


def _strings(value, out, depth=0):
    if depth > 6:
        return
    if isinstance(value, str):
        out.append(value)
    elif isinstance(value, dict):
        for key, item in value.items():
            if key not in CONTENT_KEYS:
                _strings(item, out, depth + 1)
    elif isinstance(value, list):
        for item in value:
            _strings(item, out, depth + 1)


def _secret(event):
    found = []
    _strings(event, found)
    blob = "\n".join(found)
    for marker in SECRET_MARKERS:
        # a whole name only, as botoffice.rules.marker_in (`/data/token` is not `/data/tokenizer.json`)
        before = r"(?<![\w-])" if marker[:1].isalnum() else ""
        after = r"(?!\w)" if marker[-1:].isalnum() else ""
        if marker in blob and re.search(before + re.escape(marker) + after, blob):
            return marker
    return None


def _loopback(url):
    """http://127.0.0.1:<port> or http://localhost:<port>, judged by the parsed host (Sec 9:
    `http://127.0.0.1:1@evil/` has host evil)."""
    try:
        parsed = urllib.parse.urlsplit(url)
        port = parsed.port
    except ValueError:
        return False
    return (parsed.scheme == "http" and parsed.hostname in LOOPBACK_HOSTS and port is not None
            and not parsed.username and not parsed.password)


def _mode(argv):
    if "--mode" in argv:
        index = argv.index("--mode")
        if index + 1 < len(argv) and argv[index + 1] in MODES:
            return argv[index + 1]
    path = os.environ.get("BOT_OFFICE_GATE_FILE")
    if path:
        try:
            with open(path, encoding="utf-8") as handle:
                value = json.load(handle).get("mode")
            if value in MODES:
                return value
        except (OSError, ValueError, AttributeError):
            pass
        return "unattended"  # a gate file we cannot read: the strictest mode
    return None


def _guard():
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "src"))
    from botoffice import git_guard  # stdlib only
    return git_guard


def _local_guard(event):
    """The git guard and the send class without the controller (src/botoffice/git_guard.py): a
    reason to refuse, or None. Never allowed just because the controller cannot be asked."""
    git_guard = _guard()
    data = event.get("tool_input") or event.get("input") or event.get("toolInput") or {}
    if not isinstance(data, dict):
        data = {}
    command = data.get("command") if "command" in data else event.get("command")
    if isinstance(command, list):
        command = " ".join(str(part) for part in command)
    tool = str(event.get("tool_name") or event.get("tool") or event.get("toolName") or "")
    cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else None
    command = str(command or "")
    guarded = git_guard.classify(tool, command, data, cwd)
    sending = None if guarded else git_guard.send_reason(tool, command, data, cwd)
    if guarded or sending:
        # fix3 #4: the controller shows the owner a Needs-you notice for it when the job ends
        git_guard.record_refusal(command or f"{tool} {json.dumps(data, sort_keys=True)[:400]}", guarded or sending,
                                 git_guard.SEND_KEY if sending else git_guard.PRESET)
    return guarded or sending


class _OutOfTime(Exception):
    pass


def _out_of_time(signum, frame):
    raise _OutOfTime()


def main(argv):
    provider = argv[1] if len(argv) > 1 and argv[1] in PROVIDERS else "claude"
    try:
        signal.signal(signal.SIGALRM, _out_of_time)
        signal.setitimer(signal.ITIMER_REAL, DEADLINE)
        return _decide(provider, argv)
    except _OutOfTime:
        return _answer(provider, False, "Bot-Office gate: no answer in time; action refused.")
    except BaseException as exc:  # fail closed: a crash never lets the call through
        if isinstance(exc, KeyboardInterrupt):
            raise
        return _answer(provider, False, f"Bot-Office gate: the check failed ({type(exc).__name__}); action refused.")
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)


def _decide(provider, argv):
    mode = _mode(argv)
    token = os.environ.get("BOT_OFFICE_AGENT_TOKEN", "")
    url = os.environ.get("BOT_OFFICE_API_URL", "")
    if mode is None and not token:
        return 0  # not a Bot-Office job (e.g. the owner's own CLI): no-op
    raw = sys.stdin.buffer.read(STDIN_LIMIT + 1)
    if len(raw) > STDIN_LIMIT:
        return _answer(provider, False, "Bot-Office gate: the tool call is too large to check; action refused.")
    try:
        event = json.loads(raw.decode("utf-8"))
    except ValueError:
        event = None
    if not _guard().readable_event(event):
        return _answer(provider, False, "Bot-Office gate: the tool call could not be read; action refused.")
    marker = _secret(event)
    if not token or not url:
        if mode != "local":
            return _answer(provider, False, "Bot-Office gate: no job token in this run; action refused.")
        if marker:
            return _answer(provider, False, f"Bot-Office gate: protected path ({marker}); action refused.")
        guarded = _local_guard(event)
        if guarded:
            return _answer(provider, False, f"Bot-Office gate: {guarded} needs the owner's approval, and a job "
                                            "with no bot cannot wait for it; action refused (the owner gets a "
                                            "notice). Do not run it another way.")
        return _answer(provider, True)
    if not _loopback(url):
        return _answer(provider, False, "Bot-Office gate: the controller URL is not loopback; action refused.")
    body = json.dumps({"provider": provider, "event": event}).encode()
    request = urllib.request.Request(url.rstrip("/") + "/v1/agent/gate", data=body, method="POST",
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=TIMEOUT) as response:
            answer = json.loads(response.read(65536).decode())
    except (urllib.error.URLError, OSError, ValueError) as exc:
        why = f"protected path ({marker})" if marker else f"controller unreachable ({type(exc).__name__})"
        return _answer(provider, False, f"Bot-Office gate: {why}; action refused.")
    if isinstance(answer, dict) and answer.get("decision") == "allow":
        return _answer(provider, True)
    reason = answer.get("reason") if isinstance(answer, dict) else None
    return _answer(provider, False, str(reason or "Bot-Office gate: action refused."))


if __name__ == "__main__":
    sys.exit(main(sys.argv))
