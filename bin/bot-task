#!/usr/bin/env python3
"""Assignments, wake-ups and routines of the bot whose turn is running (job-scoped token only)."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

HELP = """bot-task: your assignments, wake-ups and routines (works only inside a Bot-Office turn)

  bot-task tasks [--bot NAME|--all] [--closed]    task lists by stage
  bot-task board                                  all bots’ open tasks
  bot-task add TITLE [--goal G] [--done-when D] [--for BOT] [--parent ID|current] [--first]
  bot-task start ID|current | block ID --note TEXT | wait ID --on user|BOT --note TEXT
  bot-task drop ID --note TEXT | edit ID --version N [--title T] [--goal G] [--done-when D] [--due DATE] [--position N]
  bot-task changes [--since EVENT_ID]
  bot-task list                                   your open assignments and the children you created
  bot-task show [<id>|current]                    one assignment with its recent events
  bot-task status <id>|current <state> [--note TEXT]
        state: done | continue | blocked | waiting_on_user | waiting_on_bot
  bot-task checkpoint <id>|current <file>|-      save a checkpoint (at most 4 kB) for your next turns
  bot-task note <id> TEXT                         add a note to your own assignment or to a child you created
  bot-task create --title T [--goal G] [--done-when D] [--for BOT --parent <id>|current] [--no-start]

  bot-task wake <id>|current|- (--at ISO | --in 2h | --on-change <id>) [--note TEXT]
        wake yourself later (5 min .. 30 days ahead; at most 5 pending, 24 a day); "-" = no assignment
  bot-task wakes                                  your pending wake-ups
  bot-task unwake <wake-up id>
  bot-task routine add --cron "0 9 * * 1-5" --prompt TEXT [--name N]   (at most 10, at least 15 min apart)
  bot-task routine list | edit <id> [--cron C] [--prompt P] [--name N] [--on|--off] | rm <id>
"""

UNITS = {"m": 1, "h": 60, "d": 24 * 60}


def call(method, path, body=None):
    url = os.environ["BOT_OFFICE_API_URL"] + path
    token = os.environ["BOT_OFFICE_AGENT_TOKEN"]
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        try:
            error = json.loads(exc.read())
            detail = error.get("detail")
        except ValueError:
            error = {}
            detail = exc.reason
        if not path.startswith("/v1/agent/tasks"):
            raise SystemExit(f"bot-task: {exc.code} {detail}") from None
        print(f"bot-task: {exc.code} {detail}", file=sys.stderr)
        if exc.code == 409 and error.get("current"):
            print("Current task:", file=sys.stderr)
            print(json.dumps(error["current"], ensure_ascii=False, indent=2), file=sys.stderr)
            print("Changes:", file=sys.stderr)
            print(json.dumps(error.get("changes", []), ensure_ascii=False, indent=2), file=sys.stderr)
            print("Retry with the current version.", file=sys.stderr)
        raise SystemExit(3 if exc.code == 409 and error.get("current") else
                         {403: 4, 429: 5}.get(exc.code, 2 if exc.code in (400, 422) else 1)) from None
    return json.loads(raw) if raw else None


def quote(ref):
    return urllib.parse.quote(ref or "current", safe="")


def show(item):
    meter = f"{item['turns_used']}/{item['budget_turns']} turns, {round(item['minutes_used'])}/{item['budget_minutes']} min"
    print(f"{item['id']}  [{item['status']}]  {item['title']}  ({meter})")
    if item.get("status_note"):
        print(f"  note: {item['status_note']}")
    for event in item.get("events", []):
        print(f"  {event['created_at'][:16]} {event['kind']}: {event['note']}")


def show_task(item):
    show({**item, "id": item["id"][:8]})


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(HELP)
        return 0
    command, rest = argv[0], argv[1:]
    parser = argparse.ArgumentParser(prog=f"bot-task {command}")
    if command in ("tasks", "board"):
        group = parser.add_mutually_exclusive_group()
        group.add_argument("--bot")
        group.add_argument("--all", action="store_true")
        parser.add_argument("--closed", action="store_true")
        args = parser.parse_args(rest)
        params = {}
        if args.bot: params["bot"] = args.bot
        if args.all or command == "board": params["bot"] = "all"
        if args.closed: params["closed"] = "1"
        items = call("GET", "/v1/agent/tasks?" + urllib.parse.urlencode(params))
        for stage, label in (("not_started", "Not started"), ("in_progress", "In progress"), ("completed", "Completed")):
            print(label + ":")
            for item in items:
                if item["stage"] != stage and not (stage == "completed" and item["stage"] == "dropped"): continue
                flags = [item["status"]] if item.get("waiting") or item.get("blocked") or item["stage"] == "dropped" else []
                print(f"  {item['id'][:8]}  [{label}" + (" · " + ", ".join(flags) if flags else "") + f"]  {item['title']}  ({item['turns_used']}/{item['budget_turns']} turns, {round(item['minutes_used'])}/{item['budget_minutes']} min)  {item['created_by']} / {item['origin']}")
    elif command == "add":
        parser.add_argument("title")
        parser.add_argument("--goal")
        parser.add_argument("--done-when")
        parser.add_argument("--for", dest="for_bot")
        parser.add_argument("--parent", dest="parent_id")
        parser.add_argument("--first", action="store_true")
        args = parser.parse_args(rest)
        body = {k: v for k, v in vars(args).items() if v is not None and k != "first"}
        if args.first:
            params = {"closed": 1}
            if args.for_bot: params["bot"] = args.for_bot
            items = call("GET", "/v1/agent/tasks?" + urllib.parse.urlencode(params))
            body["position"] = min((i["position"] for i in items if i.get("position") is not None), default=0) - 1
        created = call("POST", "/v1/agent/tasks", body)
        if args.first and not args.for_bot and any(i.get("position") is None for i in items):
            call("POST", "/v1/agent/tasks/reorder", {"order": [created["id"]] + [i["id"] for i in items]})
        elif args.first and args.for_bot and any(i.get("position") is None for i in items):
            print("bot-task: older tasks without positions may still appear first; the list owner can reorder them", file=sys.stderr)
        show_task(created)
    elif command == "edit":
        parser.add_argument("id")
        parser.add_argument("--version", type=int, required=True)
        parser.add_argument("--title")
        parser.add_argument("--goal")
        parser.add_argument("--done-when")
        parser.add_argument("--due", dest="due_at")
        parser.add_argument("--position", type=float)
        args = parser.parse_args(rest)
        body = {k: v for k, v in vars(args).items() if k != "id" and v is not None}
        if len(body) == 1: parser.error("at least one field is required")
        show_task(call("PATCH", "/v1/agent/tasks/" + quote(args.id), body))
    elif command in ("start", "block", "wait", "drop"):
        parser.add_argument("id")
        if command in ("block", "wait", "drop"): parser.add_argument("--note", required=True)
        if command == "wait": parser.add_argument("--on", required=True)
        args = parser.parse_args(rest)
        path = "/v1/agent/tasks/" + quote(args.id)
        if command == "drop": body, path = {"note": args.note}, path + "/drop"
        else:
            state = {"start": "continue", "block": "blocked", "wait": "waiting_on_user" if command == "wait" and args.on == "user" else "waiting_on_bot"}[command]
            note = getattr(args, "note", "")
            if command == "wait" and args.on != "user": note = args.on + ": " + note
            body, path = {"state": state, "note": note}, path + "/status"
        show_task(call("POST", path, body))
    elif command == "changes":
        parser.add_argument("--since", type=int)
        args = parser.parse_args(rest)
        result = call("GET", "/v1/agent/tasks/changes" + ("?since=" + str(args.since) if args.since is not None else ""))
        for event in result["changes"]:
            print(f"{event['id']}  {event['assignment_id'][:8]}  {event['kind']}  {event['actor']}  {event.get('title', '')}  {event.get('note', '')}")
        print(f"Last event: {result['last_event']}")
    elif command == "list":
        for item in call("GET", "/v1/agent/assignments"):
            show(item)
    elif command == "show":
        parser.add_argument("id", nargs="?", default="current")
        args = parser.parse_args(rest)
        show(call("GET", f"/v1/agent/assignments/{quote(args.id)}"))
    elif command == "status":
        parser.add_argument("id")
        parser.add_argument("state")
        parser.add_argument("--note", default="")
        args = parser.parse_args(rest)
        show(call("POST", f"/v1/agent/assignments/{quote(args.id)}/status", {"state": args.state, "note": args.note}))
    elif command == "checkpoint":
        parser.add_argument("id")
        parser.add_argument("file")
        args = parser.parse_args(rest)
        if args.file == "-":
            text = sys.stdin.read()
        else:
            with open(args.file, encoding="utf-8") as stream:
                text = stream.read()
        show(call("POST", f"/v1/agent/assignments/{quote(args.id)}/checkpoint", {"text": text}))
    elif command == "note":
        parser.add_argument("id")
        parser.add_argument("text")
        args = parser.parse_args(rest)
        call("POST", f"/v1/agent/assignments/{quote(args.id)}/note", {"text": args.text})
        print("noted")
    elif command == "create":
        parser.add_argument("--title", required=True)
        parser.add_argument("--goal", default="")
        parser.add_argument("--done-when", default="")
        parser.add_argument("--for", dest="for_bot")
        parser.add_argument("--parent")
        parser.add_argument("--no-start", action="store_true")
        args = parser.parse_args(rest)
        body = {"title": args.title, "goal": args.goal, "done_when": args.done_when, "start": not args.no_start}
        if args.for_bot:
            body["for_bot"] = args.for_bot
        if args.parent:
            body["parent_id"] = args.parent
        show(call("POST", "/v1/agent/assignments", body))
    elif command == "wake":
        parser.add_argument("id")
        when = parser.add_mutually_exclusive_group()
        when.add_argument("--at")
        when.add_argument("--in", dest="within")
        parser.add_argument("--on-change")
        parser.add_argument("--note", default="")
        args = parser.parse_args(rest)
        body = {"note": args.note}
        if args.id != "-":
            body["assignment_id"] = args.id
        if args.at:
            body["due_at"] = args.at
        if args.within:
            amount, unit = args.within[:-1], args.within[-1:].lower()
            if not amount.isdigit() or unit not in UNITS:
                raise SystemExit("bot-task: --in takes a number and m, h or d, e.g. 90m, 2h, 3d")
            body["in_minutes"] = int(amount) * UNITS[unit]
        if args.on_change:
            body["on_assignment"] = args.on_change
        show_wakeup(call("POST", "/v1/agent/wakeups", body))
    elif command == "wakes":
        for wakeup in call("GET", "/v1/agent/wakeups"):
            show_wakeup(wakeup)
    elif command == "unwake":
        parser.add_argument("id")
        call("DELETE", f"/v1/agent/wakeups/{quote(parser.parse_args(rest).id)}")
        print("cancelled")
    elif command == "routine":
        return routine(rest)
    else:
        print(HELP, file=sys.stderr)
        return 2
    return 0


def show_wakeup(item):
    when = item.get("due_at") or ""
    if item.get("on_assignment"):
        when = (when + " or " if when else "") + f"when {item['on_assignment']} changes"
    print(f"{item['id']}  [{item['status']}]  {when}  {item.get('note', '')}")


def show_routine(item):
    state = "on" if item["enabled"] else "off"
    print(f"{item['id']}  [{state}, {item['created_by']}]  {item['cron']}  {item.get('name') or item['prompt'][:60]}")


def routine(argv):
    action, rest = (argv[0], argv[1:]) if argv else ("list", [])
    parser = argparse.ArgumentParser(prog=f"bot-task routine {action}")
    if action == "list":
        for item in call("GET", "/v1/agent/routines"):
            show_routine(item)
    elif action == "add":
        parser.add_argument("--cron", required=True)
        parser.add_argument("--prompt", required=True)
        parser.add_argument("--name")
        args = parser.parse_args(rest)
        show_routine(call("POST", "/v1/agent/routines", {"cron": args.cron, "prompt": args.prompt, "name": args.name}))
    elif action == "edit":
        parser.add_argument("id")
        parser.add_argument("--cron")
        parser.add_argument("--prompt")
        parser.add_argument("--name")
        parser.add_argument("--on", dest="enabled", action="store_true", default=None)
        parser.add_argument("--off", dest="enabled", action="store_false")
        args = parser.parse_args(rest)
        body = {k: v for k, v in vars(args).items() if k != "id" and v is not None}
        show_routine(call("PATCH", f"/v1/agent/routines/{quote(args.id)}", body))
    elif action == "rm":
        parser.add_argument("id")
        call("DELETE", f"/v1/agent/routines/{quote(parser.parse_args(rest).id)}")
        print("removed")
    else:
        print(HELP, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyError as exc:
        print(f"bot-task: {exc} is not set (bot-task works only inside a Bot-Office turn)", file=sys.stderr)
        raise SystemExit(1) from None
    except OSError as exc:
        print(f"bot-task failed: {exc}", file=sys.stderr)
        raise SystemExit(1) from None
