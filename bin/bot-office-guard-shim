#!/usr/bin/env python3
"""PATH shim for git, gh, curl, wget, httpie/xh and mail senders (bin/git etc. are stubs that run this
file): the git guard and the send class for engines that have no hook, and GitHub tickets for all.

Bot-Office puts bin/ first on a bot's PATH. For an engine that bin/bot-office-gate cannot hook
(opencode, restricted Codex) the run's env has BOT_OFFICE_GUARD_SHIM=1: a push to the default branch, a
merge, a force-push, a deletion or a repo-settings change is then sent to the controller as the same
gate event a hook would send, and runs only when the owner has approved that card. Everything else
runs the real program at once. The variable stays set for the program's children (a git alias, a
hook, a script it runs reach the shim again). Without BOT_OFFICE_GUARD_SHIM (hooked engines, the
owner's own shell) this is a pass-through. It fails closed: a crash refuses the command.

GitHub credential (fix3, docs/APPROVALS.md "GitHub credentials"): for a git call that reaches a
remote (push, fetch, pull, clone, ls-remote, remote update) and for every gh call, the shim sends the
call's words and directory to POST /v1/agent/github-ticket. The controller works out the operation and
the repositories itself and answers with one-time tickets only for a call it allows (a protected push
or gh call needs the owner's approval first). git gets them as BOT_OFFICE_GITHUB_TICKETS for
bin/bot-office-credential; for gh the shim exchanges its ticket for the token (POST
/v1/agent/github-token) and passes it as GH_TOKEN to that one gh process only. Stdlib only; never
prints the token.
"""
import json
import os
import shlex
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
TIMEOUT = 20
# git subcommands that reach a remote (the controller decides; this only saves a call for the rest)
GIT_REMOTE = ("push", "fetch", "pull", "clone", "ls-remote", "remote", "archive")
GIT_VALUE_OPTS = ("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--super-prefix", "--config-env")


def real_program(name):
    own = {os.path.realpath(str(HERE)), os.path.realpath(os.path.dirname(os.path.abspath(sys.argv[0])))}
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory or os.path.realpath(directory) in own:
            continue
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def run(name, program, args):
    env = dict(os.environ)
    env.pop("BOT_OFFICE_GITHUB_TICKETS", None)  # only tickets issued for this call
    if name == "gh" or (name == "git" and reaches_remote(args) and credential_helper_set()):
        tickets = github_tickets([name, *args])
        if tickets and name == "git":
            env["BOT_OFFICE_GITHUB_TICKETS"] = " ".join(tickets)
        elif tickets:
            token = exchange(tickets[0])
            if token:
                env["GH_TOKEN"] = token
    os.execve(program, [name, *args], env)


def reaches_remote(args):
    i = 0
    while i < len(args) and args[i].startswith("-"):
        i += 2 if args[i] in GIT_VALUE_OPTS else 1
    return i < len(args) and args[i] in GIT_REMOTE


def credential_helper_set():
    """The run's git config names bin/bot-office-credential (the controller holds a GitHub token)."""
    count = os.environ.get("GIT_CONFIG_COUNT", "0")
    return count.isdigit() and any(os.environ.get(f"GIT_CONFIG_VALUE_{i}", "").endswith("bot-office-credential")
                                   for i in range(min(int(count), 50)))


def post(path, body):
    """POST to the controller with the job's token: (status, answer dict) or (None, None)."""
    token = os.environ.get("BOT_OFFICE_AGENT_TOKEN", "")
    url = os.environ.get("BOT_OFFICE_API_URL", "")
    if not token or not url or not loopback(url):
        return None, None
    request = urllib.request.Request(url.rstrip("/") + path, method="POST", data=json.dumps(body).encode(),
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=TIMEOUT) as response:
            answer = json.loads(response.read(65536).decode() or "{}")
            return response.status, answer if isinstance(answer, dict) else {}
    except urllib.error.HTTPError as exc:
        return exc.code, {}
    except (urllib.error.URLError, OSError, ValueError):
        return None, None


def github_tickets(argv):
    """One-time tickets the controller issues for this call (none: not GitHub, not allowed, no token)."""
    status, answer = post("/v1/agent/github-ticket", {"argv": argv, "cwd": os.getcwd()})
    tickets = answer.get("tickets") if status == 200 and answer else None
    return [t for t in tickets if isinstance(t, str) and t.isprintable() and " " not in t][:8] if isinstance(
        tickets, list) else []


def exchange(ticket):
    """The GitHub token for one ticket (gh), or None."""
    status, answer = post("/v1/agent/github-token", {"host": "github.com", "ticket": ticket})
    value = answer.get("token") if status == 200 and answer else None
    return value if isinstance(value, str) and value and "\n" not in value else None


def gate_mode():
    try:
        with open(os.environ.get("BOT_OFFICE_GATE_FILE") or "", encoding="utf-8") as handle:
            return json.load(handle).get("mode")
    except (OSError, ValueError, AttributeError):
        return None


def refuse(text):
    sys.stderr.write("Bot-Office guard: " + text + "\n")
    return 126


def loopback(url):
    try:
        parsed = urllib.parse.urlsplit(url)
        return (parsed.scheme == "http" and parsed.hostname in ("127.0.0.1", "localhost")
                and parsed.port is not None and not parsed.username and not parsed.password)
    except ValueError:
        return False


def ask(command, cwd):
    token = os.environ.get("BOT_OFFICE_AGENT_TOKEN", "")
    url = os.environ.get("BOT_OFFICE_API_URL", "")
    if not token or not url or not loopback(url):
        return False, "no way to ask the owner from here; action refused."
    event = {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": command}, "cwd": cwd}
    body = json.dumps({"provider": "shim", "event": event}).encode()
    request = urllib.request.Request(url.rstrip("/") + "/v1/agent/gate", data=body, method="POST",
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=TIMEOUT) as response:
            answer = json.loads(response.read(65536).decode() or "{}")
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return False, f"controller unreachable ({type(exc).__name__}); action refused."
    if isinstance(answer, dict) and answer.get("decision") == "allow":
        return True, ""
    return False, str((answer.get("reason") if isinstance(answer, dict) else "") or "action refused.")


def main():
    try:
        return _main()
    except SystemExit:
        raise
    except BaseException as exc:  # fail closed: a crash never runs the command
        if isinstance(exc, KeyboardInterrupt):
            raise
        return refuse(f"the check failed ({type(exc).__name__}); action refused.")


def _main():
    # bin/git, bin/gh, bin/curl, bin/wget are two-line stubs: `exec bot-office-guard-shim --as <name> "$@"`
    if len(sys.argv) > 2 and sys.argv[1] == "--as":
        name, args = os.path.basename(sys.argv[2]), sys.argv[3:]
    else:
        name, args = os.path.basename(sys.argv[0]), sys.argv[1:]
    program = real_program(name)
    if program is None:
        return refuse(f"{name}: command not found")
    if os.environ.get("BOT_OFFICE_GUARD_SHIM") != "1":
        run(name, program, args)
    sys.path.insert(0, str(HERE.parent / "src"))
    try:
        from botoffice import git_guard
    except ImportError:
        return refuse("the guard module is missing; action refused.")
    command = shlex.join([name, *args])
    cwd = os.getcwd()
    reason = git_guard.judge("Bash", command, None, cwd)
    if reason is None:
        run(name, program, args)
    if not os.environ.get("BOT_OFFICE_AGENT_TOKEN") and gate_mode() == "local":
        # a job with no bot cannot wait for a card: refused, and the owner gets a Needs-you notice
        sending = git_guard.classify("Bash", command, None, cwd) is None
        git_guard.record_refusal(command, reason, git_guard.SEND_KEY if sending else git_guard.PRESET)
        return refuse(f"{reason} needs the owner's approval, and a job with no bot cannot wait for it; "
                      "action refused (the owner gets a notice).")
    allowed, why = ask(command, cwd)
    if allowed:
        run(name, program, args)
    return refuse(why)


if __name__ == "__main__":
    sys.exit(main())
