#!/usr/bin/env python3
"""Bot-Office git credential helper for github.com: the bot's git gets the GitHub token from the
controller, never from a file in the bot's home or a variable in its environment.

Bot-Office runs set it through their environment (GIT_CONFIG_COUNT, when the controller holds a
token: docs/APPROVALS.md "GitHub credentials"), after an empty helper that clears any other helper
for https://github.com (with credential.useHttpPath, so git names the repository). fix3: `get`
exchanges the one-time tickets the git shim got for this call (BOT_OFFICE_GITHUB_TICKETS: the
controller issues them only for an operation it allows, each bound to this job, one repository and
one operation) at POST $BOT_OFFICE_API_URL/v1/agent/github-token, and prints the git credential
lines. With no ticket, no token, no controller or a refusal it prints nothing (git then has no
credential and the push or fetch fails: fail closed). `store` and `erase` do nothing (the token is
never written anywhere). Stdlib only; prints the token only to git.
"""
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

TIMEOUT = 20
HOSTS = ("github.com",)


def loopback(url):
    try:
        parsed = urllib.parse.urlsplit(url)
        return (parsed.scheme == "http" and parsed.hostname in ("127.0.0.1", "localhost")
                and parsed.port is not None and not parsed.username and not parsed.password)
    except ValueError:
        return False


def main(argv):
    attributes = {}
    for line in sys.stdin.read(65536).splitlines():
        key, _, value = line.partition("=")
        attributes[key] = value
    if len(argv) < 2 or argv[1] != "get":
        return 0
    if attributes.get("protocol") != "https" or attributes.get("host", "").lower() not in HOSTS:
        return 0
    token = os.environ.get("BOT_OFFICE_AGENT_TOKEN", "")
    url = os.environ.get("BOT_OFFICE_API_URL", "")
    tickets = os.environ.get("BOT_OFFICE_GITHUB_TICKETS", "").split()[:8]
    if not token or not url or not loopback(url) or not tickets or not attributes.get("path"):
        return 0
    body = json.dumps({"host": attributes["host"].lower(), "path": attributes["path"][:300], "tickets": tickets})
    request = urllib.request.Request(url.rstrip("/") + "/v1/agent/github-token", data=body.encode(), method="POST",
                                     headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(request, timeout=TIMEOUT) as response:
            answer = json.loads(response.read(65536).decode())
    except (urllib.error.URLError, OSError, ValueError):
        return 0
    secret = answer.get("token") if isinstance(answer, dict) else None
    if isinstance(secret, str) and secret and "\n" not in secret:
        sys.stdout.write(f"username=x-access-token\npassword={secret}\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except Exception:  # noqa: BLE001 — no credential, never a traceback near a token
        sys.exit(0)
