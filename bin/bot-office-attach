#!/usr/bin/env python3
"""Mark an image for the current bot's final reply."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from botoffice.outgoing_images import attach_file  # noqa: E402


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: bot-office-attach <file>", file=sys.stderr)
        return 1
    try:
        path = attach_file(sys.argv[1])
    except (OSError, ValueError) as exc:
        print(f"bot-office-attach: {exc}", file=sys.stderr)
        return 1
    print(f"Image queued for reply: {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
